{
	"workspaces": {
		".": {
			"entry": [
				"scripts/*.ts"
			]
		},
		"apps/app": {
			"entry": [
				"src/routes/**/*.{ts,tsx}",
				"src/lib/server/nitro-content-security-policy.ts",
				"src/**/*.integration.ts",
				"project.inlang/paraglide.config.ts"
			],
			"ignoreDependencies": [
				"postcss"
			],
			"ignoreIssues": {
				"src/components/ui/**": [
					"exports",
					"types"
				]
			}
		},
		"apps/e2e": {
			"playwright": false,
			"entry": [
				"playwright.config.ts",
				"tests/**/*.ts",
				"fixtures/**/*.ts"
			]
		},
		"apps/workers": {
			"entry": [
				"src/start-workers.ts",
				"src/**/*.integration.ts"
			],
			"ignoreDependencies": [
				"@kreuzberg/node"
			]
		},
		"apps/web": {
			"entry": [
				"scripts/*.ts"
			]
		},
		"packages/contracts": {},
		"packages/core": {
			"entry": [
				"test/**/*.{test,integration}.ts"
			]
		},
		"packages/db": {
			"entry": [
				"src/schema/*.ts",
				"test/**/*.integration.ts"
			]
		},
		"packages/pg-boss": {
			"entry": [
				"test/**/*.{test,integration}.ts"
			]
		},
		"packages/spice-db": {
			"entry": [
				"test/**/*.{test,integration}.ts"
			]
		},
		"packages/notifications": {
			"entry": [
				"test/**/*.{test,integration}.ts"
			],
			"project": [
				"src/**/*.{ts,tsx}",
				"test/**/*.ts"
			],
			"includeEntryExports": true
		},
		"packages/testing": {
			"includeEntryExports": true
		},
		"packages/*": {
			"entry": [
				"test/**/*.{test,integration}.ts"
			],
			"includeEntryExports": true
		}
	}
}
