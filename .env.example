# Authentication & Security
BETTER_AUTH_SECRET="your_long_random_secret_key_here"
BETTER_AUTH_URL="http://localhost:3000"
ENCRYPTION_KEY="your_32_character_encryption_key_here"
BASE_URL="http://localhost:3000"

# Database Configuration
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="your_postgres_password"
POSTGRES_DB="sokratest-v2"
POSTGRES_HOST="localhost"
POSTGRES_SSL="false"

# Email Configuration (SMTP)
SMTP_HOST="localhost"
SMTP_PORT=25
SMTP_USERNAME="your_smtp_username"
SMTP_PASSWORD="your_smtp_password"

# S3-Compatible Object Storage
# Example for local MinIO setup:
# S3_ENDPOINT="127.0.0.1"
# S3_PORT=9000
# S3_ACCESS_KEY=your_minio_access_key
# S3_SECRET_KEY=your_minio_secret_key
# S3_USE_SSL=false

# Example for Supabase Storage:
S3_ENDPOINT="https://your-project-id.supabase.co/storage/v1/s3"
S3_ACCESS_KEY=your_supabase_access_key
S3_SECRET_KEY=your_supabase_secret_key
S3_USE_SSL=true

# Application Base URL
VITE_BASE_URL="http://localhost:3000"

# AI Services (OpenAI-compatible API)
OPENAI_COMPATIBLE_BASE_URL=https://your-ai-provider.com/v1
OPENAI_COMPATIBLE_API_KEY=your_openai_compatible_api_key

# LLM Observability (Langfuse)
LANGFUSE_SECRET_KEY="sk-lf-your-langfuse-secret-key"
LANGFUSE_PUBLIC_KEY="pk-lf-your-langfuse-public-key"
LANGFUSE_BASEURL="https://your-langfuse-instance.com"

# Vector Database (Qdrant)
QDRANT_URL=https://your-qdrant-instance.com/
QDRANT_API_KEY=your_qdrant_api_key

# SpiceDB Authorization
SPICEDB_ENDPOINT=localhost:50051
SPICEDB_TOKEN=your_spicedb_token
SPICEDB_GRPC_PRESHARED_KEY=your_spicedb_grpc_preshared_key
SPICEDB_POSTGRES_USER=postgres
SPICEDB_POSTGRES_PASSWORD=postgres

# Analytics (Umami) - VITE_ prefix exposes variables to the client
VITE_UMAMI_SCRIPT_URL=https://your-umami-instance.com/script.js
VITE_UMAMI_WEBSITE_ID=your_umami_website_id

# Open Telemetry
OTEL_TRACES_EXPORTER="otlp"
OTEL_EXPORTER_OTLP_PROTOCOL="http/protobuf"
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT="http://your-otel-endpoint:4318/v1/traces"
OTEL_NODE_RESOURCE_DETECTORS="env,host,os"
OTEL_SERVICE_NAME="sokratest"
# OTEL_EXPORTER_OTLP_HEADERS="header-value=your_header_value" - optional
