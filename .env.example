# Public app URLs
BASE_URL="http://localhost:3000"
BETTER_AUTH_URL="http://localhost:3000"
VITE_BASE_URL="http://localhost:3000"

# Authentication & encryption
BETTER_AUTH_SECRET="replace-with-a-long-random-secret"
ENCRYPTION_KEY="replace-with-a-32-to-64-character-encryption-key"

# Database & cache
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="replace-with-postgres-password"
POSTGRES_HOST="127.0.0.1"
POSTGRES_PORT="5432"
POSTGRES_DB="sokratest-v2"
VALKEY_URL="redis://127.0.0.1:6379"

# S3-compatible object storage
# Example for local MinIO:
# S3_ENDPOINT="http://127.0.0.1:9000"
# S3_PUBLIC_ENDPOINT="http://localhost:9000"
# S3_ACCESS_KEY="minioadmin"
# S3_SECRET_KEY="minioadmin"
#
# Example for Supabase Storage:
# S3_ENDPOINT="https://your-project-id.supabase.co/storage/v1/s3"
S3_ENDPOINT="http://127.0.0.1:9000"
S3_PUBLIC_ENDPOINT="http://localhost:9000"
S3_REGION="eu-central-1"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"

# AI services
OPENAI_COMPATIBLE_BASE_URL="https://your-ai-provider.example/v1"
OPENAI_COMPATIBLE_API_KEY="replace-with-openai-compatible-api-key"
DOCLING_URL="http://127.0.0.1:8080"
DOCLING_API_KEY="replace-with-docling-api-key"

# Vector database (Qdrant)
QDRANT_URL="http://127.0.0.1:6333/"
QDRANT_API_KEY="replace-with-qdrant-api-key"
# Enable BM25 sparse vectors / hybrid retrieval in Qdrant.
# Set to false on low-resource hosts to reduce ingestion CPU load.
# WARNING: Do not toggle this on an existing collection without reindexing.
QDRANT_ENABLE_SPARSE_VECTORS=false

# Authorization (SpiceDB)
SPICEDB_ENDPOINT="127.0.0.1:50051"
SPICEDB_TOKEN="replace-with-spicedb-token"
# Used by the Compose-managed SpiceDB service in this repo.
SPICEDB_GRPC_PRESHARED_KEY="replace-with-spicedb-grpc-preshared-key"
SPICEDB_POSTGRES_USER="postgres"
SPICEDB_POSTGRES_PASSWORD="postgres"

# Email delivery (optional)
# Leave SMTP_HOST and SMTP_FROM unset to stay in log-only mode.
# If you set SMTP_USERNAME, you must also set SMTP_PASSWORD.
# If you set SMTP_HOST, you must also set SMTP_FROM.
# SMTP_HOST="smtp.example.com"
SMTP_PORT=587
# SMTP_USERNAME="smtp-user"
# SMTP_PASSWORD="smtp-password"
SMTP_SECURE=true
SMTP_TLS_REJECT_UNAUTHORIZED=true
SMTP_FROM="no-reply@orcai.local"
SMTP_FROM_NAME="OrcAI Team"

# Langfuse (optional)
# LANGFUSE_SECRET_KEY="sk-lf-..."
# LANGFUSE_PUBLIC_KEY="pk-lf-..."
# LANGFUSE_BASEURL="https://your-langfuse-instance.example"

# Umami analytics (optional, exposed to the client via VITE_)
# VITE_UMAMI_SCRIPT_URL="https://your-umami-instance.example/script.js"
# VITE_UMAMI_WEBSITE_ID="your_umami_website_id"

# OpenTelemetry (optional)
# OTEL_TRACES_EXPORTER="otlp"
# OTEL_EXPORTER_OTLP_PROTOCOL="http/protobuf"
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT="http://127.0.0.1:4318/v1/traces"
# OTEL_EXPORTER_OTLP_LOGS_ENDPOINT="http://127.0.0.1:4318/v1/logs"
# OTEL_EXPORTER_OTLP_HEADERS="authorization=Bearer token"
# OTEL_NODE_RESOURCE_DETECTORS="env,host,os"
# OTEL_SERVICE_NAME="orcai"
