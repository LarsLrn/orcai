{
	"name": "@orcai/web",
	"version": "0.1.0",
	"private": true,
	"description": "OrcAI website and documentation",
	"author": "Lars Lorenz",
	"sideEffects": false,
	"type": "module",
	"scripts": {
		"build": "NODE_ENV=production bun --bun vite build && test -f .output/public/index.html",
		"dev": "vite dev  --host 127.0.0.1",
		"postinstall": "fumadocs-mdx",
		"start": "vite preview",
		"types:check": "fumadocs-mdx && tsc --noEmit"
	},
	"dependencies": {
		"@tailwindcss/vite": "catalog:",
		"@tanstack/react-router": "catalog:",
		"@tanstack/react-start": "catalog:",
		"@vitejs/plugin-react": "catalog:",
		"beautiful-mermaid": "1.1.3",
		"fumadocs-core": "16.10.7",
		"fumadocs-mdx": "15.1.0",
		"fumadocs-ui": "16.10.7",
		"lucide-react": "catalog:",
		"react": "catalog:",
		"react-dom": "catalog:",
		"tailwind-merge": "catalog:",
		"tailwindcss": "catalog:",
		"vite": "catalog:"
	},
	"devDependencies": {
		"@types/mdx": "2.0.14",
		"@types/node": "catalog:",
		"@types/react": "catalog:",
		"@types/react-dom": "catalog:",
		"nitro": "3.0.260610-beta"
	}
}
