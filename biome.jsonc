{
	"$schema": "https://biomejs.dev/schemas/2.1.4/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": false,
		"includes": [
			"**",
			"!src/routeTree.gen.ts",
			"!**/public",
			"!**/migrations",
			"!src/paraglide/**",
			"!**/.tanstack",
			"!**/.trigger"
		]
	},
	"formatter": {
		"enabled": true,
		"formatWithErrors": true,
		"indentStyle": "tab",
		"indentWidth": 2,
		"lineEnding": "lf",
		"lineWidth": 80,
		"attributePosition": "auto"
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"style": {
				"useFragmentSyntax": "warn", // Not in recommended ruleset, turning on manually
				"noYodaExpression": "warn", // Not in recommended ruleset, turning on manually
				"useDefaultParameterLast": "error", // Not in recommended ruleset, turning on manually
				"useExponentiationOperator": "off", // Obscure and arguably not easily readable
				"noUnusedTemplateLiteral": "error", // Stylistic opinion
				"noUselessElse": "error",
				"noParameterAssign": "error",
				"useAsConstAssertion": "error",
				"useEnumInitializers": "error",
				"useSelfClosingElements": "error",
				"useSingleVarDeclarator": "error",
				"useNumberNamespace": "error",
				"noInferrableTypes": "error",
				"useConst": "error",
				"useShorthandAssign": "warn",
				"useArrayLiterals": "warn",
				"useTemplate": "warn"
			},
			"suspicious": {
				"noExplicitAny": "off", // Controversial, but use of `any` is can be justified. Trust to only use when strictly necessary.
				"noHeadImportInDocument": "warn",
				"noDuplicateElseIf": "warn",
				"noIrregularWhitespace": "warn",
				"noEmptyBlockStatements": "error",
				"noFallthroughSwitchClause": "error",
				"noVar": "error",
				"useAwait": "warn" // Typically async functions without await don't need it
			},
			"correctness": {
				"useValidForDirection": "error",
				"noUndeclaredVariables": "error",
				"noUnusedVariables": "warn",
				"noUnusedImports": "warn"
			},
			"complexity": {
				"noStaticOnlyClass": "error",
				"noUselessConstructor": "error",
				"useFlatMap": "warn"
			},
			"performance": {
				"noDelete": "error",
				"noAccumulatingSpread": "warn"
			},
			"nursery": {
				"useSortedClasses": {
					"level": "info",
					"fix": "safe",
					"options": {
						"attributes": ["classList"],
						"functions": ["clsx", "cva", "cn", "tw", "tw.*"]
					}
				}
			}
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	},
	"json": {
		"formatter": {
			"enabled": true,
			"trailingCommas": "none"
		},
		"parser": {
			"allowComments": true,
			"allowTrailingCommas": false
		}
	},
	"css": {
		"formatter": {
			"enabled": true
		},
		"linter": {
			"enabled": false
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	}
}
