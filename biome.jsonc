{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": false,
		"includes": [
			"**",
			"!**/routeTree.gen.ts",
			"!**/public",
			"!**/migrations",
			"!apps/app/src/paraglide",
			"!**/.tanstack",
			"!**/*.svg"
		]
	},
	"formatter": {
		"enabled": true,
		"formatWithErrors": true,
		"indentStyle": "tab",
		"indentWidth": 2,
		"lineEnding": "lf",
		"lineWidth": 80,
		"attributePosition": "auto",
		"expand": "always"
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"style": {
				"useFragmentSyntax": "warn", // Not in recommended ruleset, turning on manually
				"noYodaExpression": "warn", // Not in recommended ruleset, turning on manually
				"useDefaultParameterLast": "error", // Not in recommended ruleset, turning on manually
				"useExponentiationOperator": "off", // Obscure and arguably not easily readable
				"noUnusedTemplateLiteral": "error", // Stylistic opinion
				"noUselessElse": "error",
				"noParameterAssign": "error",
				"useAsConstAssertion": "error",
				"useEnumInitializers": "error",
				"useSelfClosingElements": "error",
				"useSingleVarDeclarator": "error",
				"useNumberNamespace": "error",
				"noInferrableTypes": "error",
				"useConst": "error",
				"useShorthandAssign": "warn",
				"useArrayLiterals": "warn",
				"useTemplate": "warn",
				"noRestrictedImports": {
					"level": "error",
					"options": {
						"patterns": [
							{
								"group": [
									"@orcai/db/*",
									"@orcai/db/**",
									"!@orcai/db/relations",
									"!@orcai/db/schema"
								],
								"message": "Import DB modules via '@orcai/db', '@orcai/db/schema', or '@orcai/db/relations' only."
							}
						]
					}
				}
			},
			"suspicious": {
				"noExplicitAny": "off", // Controversial, but use of `any` is can be justified. Trust to only use when strictly necessary.
				"noHeadImportInDocument": "warn",
				"noDuplicateElseIf": "warn",
				"noIrregularWhitespace": "warn",
				"noEmptyBlockStatements": "error",
				"noFallthroughSwitchClause": "error",
				"noVar": "error",
				"useAwait": "warn" // Typically async functions without await don't need it
			},
			"correctness": {
				"useExhaustiveDependencies": "error",
				"useValidForDirection": "error",
				"noUndeclaredVariables": "error",
				"noUnusedVariables": "warn",
				"noUnusedImports": "warn",
				"noChildrenProp": "off" // Perfectly valid pattern in some cases (e.g. used in tanstack/react-form)
			},
			"complexity": {
				"noStaticOnlyClass": "error",
				"noUselessConstructor": "error",
				"useFlatMap": "warn"
			},
			"performance": {
				"noDelete": "error",
				"noAccumulatingSpread": "warn"
			},
			"nursery": {
				"useSortedClasses": {
					"level": "info",
					"fix": "safe",
					"options": {
						"attributes": [
							"classList"
						],
						"functions": [
							"clsx",
							"cva",
							"cn",
							"tw",
							"tw.*"
						]
					}
				}
			}
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	},
	"json": {
		"formatter": {
			"enabled": true,
			"trailingCommas": "none"
		},
		"parser": {
			"allowComments": true,
			"allowTrailingCommas": true
		}
	},
	"css": {
		"formatter": {
			"enabled": true
		},
		"linter": {
			"enabled": true
		},
		"parser": {
			"tailwindDirectives": true
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	}
}
