{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": false,
		"includes": [
			"**",
			"!**/routeTree.gen.ts",
			"!**/public",
			"!**/migrations",
			"!**/src/paraglide",
			"!**/.tanstack",
			"!**/*.svg"
		]
	},
	"formatter": {
		"enabled": true,
		"formatWithErrors": true,
		"indentStyle": "tab",
		"indentWidth": 2,
		"lineEnding": "lf",
		"lineWidth": 80,
		"attributePosition": "auto",
		"expand": "always"
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"style": {
				"useFragmentSyntax": "warn", // Not in recommended ruleset, turning on manually
				"noYodaExpression": "warn", // Not in recommended ruleset, turning on manually
				"useDefaultParameterLast": "error", // Not in recommended ruleset, turning on manually
				"useExponentiationOperator": "off", // Obscure and arguably not easily readable
				"noUnusedTemplateLiteral": "error", // Stylistic opinion
				"noUselessElse": "error",
				"noParameterAssign": "error",
				"useAsConstAssertion": "error",
				"useEnumInitializers": "error",
				"useSelfClosingElements": "error",
				"useSingleVarDeclarator": "error",
				"useNumberNamespace": "error",
				"noInferrableTypes": "error",
				"useConst": "error",
				"useShorthandAssign": "warn",
				"useArrayLiterals": "warn",
				"useTemplate": "warn",
				"noRestrictedImports": {
					"level": "error",
					"options": {
						"patterns": [
							{
								"group": [
									"@orcai/db/*",
									"@orcai/db/**",
									"!@orcai/db/relations",
									"!@orcai/db/schema"
								],
								"message": "Import DB modules via '@orcai/db', '@orcai/db/schema', or '@orcai/db/relations' only."
							}
						]
					}
				}
			},
			"suspicious": {
				"noExplicitAny": "off", // Controversial, but use of `any` is can be justified. Trust to only use when strictly necessary.
				"noHeadImportInDocument": "warn",
				"noDuplicateElseIf": "warn",
				"noIrregularWhitespace": "warn",
				"noEmptyBlockStatements": "error",
				"noFallthroughSwitchClause": "error",
				"noVar": "error",
				"useAwait": "warn", // Typically async functions without await don't need it
				"noDeprecatedImports": "error",
				"noDrizzleDeleteWithoutWhere": {
					"level": "error",
					"options": {
						"drizzleObjectName": [
							"db"
						]
					}
				},
				"noDrizzleUpdateWithoutWhere": {
					"level": "error",
					"options": {
						"drizzleObjectName": [
							"db"
						]
					}
				}
			},
			"correctness": {
				"useExhaustiveDependencies": "error",
				"useValidForDirection": "error",
				"noUndeclaredVariables": "error",
				"noUnusedVariables": "warn",
				"noUnusedImports": "warn",
				"noChildrenProp": "off" // Perfectly valid pattern in some cases (e.g. used in tanstack/react-form)
			},
			"complexity": {
				"noStaticOnlyClass": "error",
				"noUselessConstructor": "error",
				"useFlatMap": "warn"
			},
			"performance": {
				"noDelete": "error",
				"noAccumulatingSpread": "warn"
			},
			"nursery": {
				"useTailwindSortedClasses": {
					"level": "error",
					"fix": "safe"
				}
			}
		}
	},
	"overrides": [
		{
			// Test helpers that keep zedTokens are async; an unawaited call reads stale.
			"includes": [
				"**/*.integration.ts",
				"apps/e2e/**",
				"packages/*/test/**"
			],
			"linter": {
				"rules": {
					"nursery": {
						"noFloatingPromises": "error"
					}
				}
			}
		},
		{
			"includes": [
				"**/*.integration.ts"
			],
			"plugins": [
				"./packages/testing/await-before-expect.grit"
			]
		},
		{
			// Imports point from routes to components, hooks and lib, never back.
			"includes": [
				"apps/app/src/lib/**"
			],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": [
											"@/components/**",
											"@/hooks/**",
											"@/routes/**",
											"**/../components/**",
											"**/../hooks/**",
											"**/../routes/**"
										],
										"message": "lib is imported by components, hooks and routes, and imports none of them."
									},
									{
										"group": [
											"@orcai/db/*",
											"@orcai/db/**",
											"!@orcai/db/relations",
											"!@orcai/db/schema"
										],
										"message": "Import DB modules via '@orcai/db', '@orcai/db/schema', or '@orcai/db/relations' only."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			// Specs reach pages only through the fixtures, which fail a test on
			// uncaught page errors.
			"includes": [
				"apps/e2e/tests/**"
			],
			"plugins": [
				"./apps/e2e/no-browser.grit"
			],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"paths": {
									"@playwright/test": {
										"importNames": [
											"chromium",
											"firefox",
											"webkit",
											"_android",
											"_electron",
											"test"
										],
										"message": "Import test from apps/e2e/fixtures/index.ts and open further contexts with its newContext fixture, whose pages fail the test on uncaught errors."
									},
									"playwright": "Open further contexts with the newContext fixture, whose pages fail the test on uncaught errors.",
									"playwright-core": "Open further contexts with the newContext fixture, whose pages fail the test on uncaught errors."
								},
								"patterns": [
									{
										"group": [
											"@orcai/db/*",
											"@orcai/db/**",
											"!@orcai/db/relations",
											"!@orcai/db/schema"
										],
										"message": "Import DB modules via '@orcai/db', '@orcai/db/schema', or '@orcai/db/relations' only."
									}
								]
							}
						}
					}
				}
			}
		}
	],
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	},
	"json": {
		"formatter": {
			"enabled": true,
			"trailingCommas": "none"
		},
		"parser": {
			"allowComments": true,
			"allowTrailingCommas": true
		}
	},
	"css": {
		"formatter": {
			"enabled": true
		},
		"linter": {
			"enabled": true
		},
		"parser": {
			"tailwindDirectives": true
		}
	},
	"markdown": {
		"formatter": {
			"enabled": false
		},
		"parser": {
			"frontmatter": true
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"tailwind": {
		"attributes": [
			"class",
			"className",
			"classList"
		],
		"mergeFunctions": [
			"clsx",
			"cn",
			"tw"
		],
		"variantFunctions": [
			"cva"
		]
	}
}
