{
	"name": "OrcAI Dev",
	"dockerComposeFile": [
		"../docker-compose.yaml",
		"docker-compose.dev.yaml"
	],
	"service": "workspace",
	"runServices": [
		"deps",
		"workspace",
		"postgres",
		"valkey",
		"migrations",
		"seaweedfs",
		"qdrant",
		"spicedb-database",
		"spicedb-migrate",
		"spicedb",
		"spicedb-schema"
	],
	"workspaceFolder": "/workspaces/orcai",
	"remoteUser": "bun",
	"forwardPorts": [
		3000,
		3001,
		4206,
		"valkey:6379",
		"qdrant:6333",
		"seaweedfs:8333",
		"postgres:5432"
	],
	"portsAttributes": {
		"3000": {
			"label": "OrcAI App"
		},
		"3001": {
			"label": "OrcAI Web"
		},
		"4206": {
			"label": "OrcAI App Devtools"
		},
		"valkey:6379": {
			"label": "Valkey"
		},
		"qdrant:6333": {
			"label": "Qdrant Vector DB"
		},
		"seaweedfs:8333": {
			"label": "SeaweedFS S3 API"
		},
		"postgres:5432": {
			"label": "PostgreSQL Database"
		}
	},
	"customizations": {
		"vscode": {
			"extensions": [
				"inlang.vs-code-extension",
				"bradlc.vscode-tailwindcss",
				"biomejs.biome",
				"authzed.spicedb-vscode",
				"ms-azuretools.vscode-docker",
				"ms-vscode-remote.remote-containers",
				"usernamehw.errorlens",
				"oven.bun-vscode",
				"YoavBls.pretty-ts-errors",
				"FanaticPythoner.better-todo-tree",
				"pflannery.vscode-versionlens",
				"typescriptteam.native-preview"
			],
			"settings": {
				"js/ts.experimental.useTsgo": true
			}
		}
	},
	"shutdownAction": "stopCompose"
}
