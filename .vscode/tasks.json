{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "lint-all",
			"type": "shell",
			"command": "bun biome check . ; bunx tsc --noEmit",
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"problemMatcher": "$tsc",
			"presentation": {
				"reveal": "always",
				"panel": "shared"
			}
		}
	]
}
