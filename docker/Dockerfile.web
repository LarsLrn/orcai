# syntax=docker/dockerfile:1.20

ARG BUN_IMAGE=oven/bun:1.4.4-slim

# -------------------------
# Build stage
# -------------------------
FROM ${BUN_IMAGE} AS builder
WORKDIR /app

COPY --parents package.json bun.lock bunfig.toml apps/*/package.json packages/*/package.json ./

RUN bun install --frozen-lockfile --ignore-scripts --filter @orcai/web

COPY tsconfig.base.json GLOSSARY.md ./
COPY apps/web ./apps/web

WORKDIR /app/apps/web
ENV NODE_ENV=production
RUN bun run build

# -------------------------
# Runtime stage
# -------------------------
# Nitro bundles the server with its dependencies into .output.
FROM ${BUN_IMAGE} AS runtime
WORKDIR /app/apps/web

ENV NODE_ENV=production
ENV PORT=3001

COPY --from=builder --chown=bun:bun /app/apps/web/.output ./.output

USER bun

EXPOSE 3001

CMD ["bun", ".output/server/index.mjs"]
