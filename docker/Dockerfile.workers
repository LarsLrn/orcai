# syntax=docker/dockerfile:1.20

# Bundles the workers; the runtime image holds the bundle and its externals.

ARG BUN_IMAGE=oven/bun:1.4.4-slim

FROM ${BUN_IMAGE} AS builder
WORKDIR /app

COPY --parents package.json bun.lock bunfig.toml apps/*/package.json packages/*/package.json ./
RUN bun install --frozen-lockfile --ignore-scripts --filter @orcai/workers --filter @orcai/notifications

COPY tsconfig.base.json ./
COPY packages ./packages
COPY apps/workers ./apps/workers

WORKDIR /app/apps/workers
RUN bun run build

# The workers' dependencies are exactly the bundle's externals.
FROM ${BUN_IMAGE} AS prod-deps
WORKDIR /app

COPY --parents package.json bun.lock bunfig.toml apps/*/package.json packages/*/package.json ./
RUN bun install --frozen-lockfile --production --ignore-scripts --filter @orcai/workers

FROM ${BUN_IMAGE} AS runtime
WORKDIR /app/apps/workers

ENV NODE_ENV=production

RUN apt-get update && \
	apt-get install -y --no-install-recommends \
	tesseract-ocr \
	tesseract-ocr-eng \
	tesseract-ocr-deu && \
	rm -rf /var/lib/apt/lists/*

COPY --from=prod-deps --chown=bun:bun /app/node_modules /app/node_modules
COPY --from=prod-deps --chown=bun:bun /app/apps/workers/node_modules ./node_modules
COPY --from=builder --chown=bun:bun /app/apps/workers/dist ./dist

USER bun

CMD ["bun", "dist/start-workers.js"]
