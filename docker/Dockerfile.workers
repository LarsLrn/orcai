# syntax=docker/dockerfile:1.20

ARG BUN_IMAGE=oven/bun:1.4.3-slim

FROM ${BUN_IMAGE} AS prod-deps
WORKDIR /app

COPY --parents package.json bun.lock bunfig.toml apps/*/package.json packages/*/package.json ./

RUN bun install --frozen-lockfile --production --ignore-scripts

FROM prod-deps AS paraglide
RUN bun install --frozen-lockfile --ignore-scripts --filter @orcai/notifications
COPY packages/notifications ./packages/notifications
RUN bun run --filter @orcai/notifications paraglide:compile

FROM ${BUN_IMAGE} AS runtime
WORKDIR /app/apps/workers

ENV NODE_ENV=production

RUN apt-get update && \
	apt-get install -y --no-install-recommends \
	tesseract-ocr \
	tesseract-ocr-eng \
	tesseract-ocr-deu && \
	rm -rf /var/lib/apt/lists/*

COPY --chown=bun:bun package.json /app/package.json
COPY --chown=bun:bun bun.lock /app/bun.lock
COPY --chown=bun:bun bunfig.toml /app/bunfig.toml
COPY --chown=bun:bun tsconfig.base.json /app/tsconfig.base.json
COPY --from=prod-deps --chown=bun:bun /app/node_modules /app/node_modules
COPY --from=prod-deps --chown=bun:bun /app/apps /app/apps
COPY --from=prod-deps --chown=bun:bun /app/packages /app/packages
COPY --chown=bun:bun apps/workers/package.json ./package.json
COPY --chown=bun:bun apps/workers/tsconfig.json ./tsconfig.json
COPY --chown=bun:bun apps/workers/src ./src
COPY --chown=bun:bun packages /app/packages
COPY --from=paraglide --chown=bun:bun /app/packages/notifications/src/paraglide /app/packages/notifications/src/paraglide

USER bun

CMD ["bun", "run", "src/start-workers.ts"]
