# syntax=docker/dockerfile:1.7

ARG BUN_IMAGE=oven/bun:1.3.13-slim

FROM ${BUN_IMAGE} AS prod-deps
WORKDIR /app

COPY package.json bun.lock bunfig.toml ./
COPY apps/app/package.json ./apps/app/package.json
COPY apps/workers/package.json ./apps/workers/package.json
COPY packages/ai/package.json ./packages/ai/package.json
COPY packages/contracts/package.json ./packages/contracts/package.json
COPY packages/core/package.json ./packages/core/package.json
COPY packages/db/package.json ./packages/db/package.json
COPY packages/observability/package.json ./packages/observability/package.json
COPY packages/pg-boss/package.json ./packages/pg-boss/package.json
COPY packages/process/package.json ./packages/process/package.json
COPY packages/qdrant/package.json ./packages/qdrant/package.json
COPY packages/quota/package.json ./packages/quota/package.json
COPY packages/s3/package.json ./packages/s3/package.json
COPY packages/schema/package.json ./packages/schema/package.json
COPY packages/spice-db/package.json ./packages/spice-db/package.json
COPY packages/valkey/package.json ./packages/valkey/package.json

RUN bun install --frozen-lockfile --production --ignore-scripts

FROM ${BUN_IMAGE} AS runtime
WORKDIR /app/apps/workers

ENV NODE_ENV=production

RUN apt-get update && \
	apt-get install -y --no-install-recommends \
	tesseract-ocr \
	tesseract-ocr-eng \
	tesseract-ocr-deu && \
	rm -rf /var/lib/apt/lists/*

COPY --chown=bun:bun package.json /app/package.json
COPY --chown=bun:bun bun.lock /app/bun.lock
COPY --chown=bun:bun bunfig.toml /app/bunfig.toml
COPY --chown=bun:bun tsconfig.base.json /app/tsconfig.base.json
COPY --from=prod-deps --chown=bun:bun /app/node_modules /app/node_modules
COPY --from=prod-deps --chown=bun:bun /app/apps /app/apps
COPY --from=prod-deps --chown=bun:bun /app/packages /app/packages
COPY --chown=bun:bun apps/workers/package.json ./package.json
COPY --chown=bun:bun apps/workers/tsconfig.json ./tsconfig.json
COPY --chown=bun:bun apps/workers/src ./src
COPY --chown=bun:bun packages /app/packages

USER bun

CMD ["bun", "run", "start"]
