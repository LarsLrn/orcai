FROM oven/bun:1.3.14-slim

WORKDIR /app

COPY package.json bun.lock bunfig.toml ./
COPY apps/app/package.json ./apps/app/package.json
COPY apps/web/package.json ./apps/web/package.json
COPY apps/workers/package.json ./apps/workers/package.json
COPY packages/ai/package.json ./packages/ai/package.json
COPY packages/contracts/package.json ./packages/contracts/package.json
COPY packages/core ./packages/core
COPY packages/observability/package.json ./packages/observability/package.json
COPY packages/pg-boss/package.json ./packages/pg-boss/package.json
COPY packages/process/package.json ./packages/process/package.json
COPY packages/qdrant/package.json ./packages/qdrant/package.json
COPY packages/quota/package.json ./packages/quota/package.json
COPY packages/s3/package.json ./packages/s3/package.json
COPY packages/schema ./packages/schema
COPY packages/spice-db/package.json ./packages/spice-db/package.json
COPY packages/valkey/package.json ./packages/valkey/package.json
COPY packages/db ./packages/db

WORKDIR /app/packages/db

RUN bun install --frozen-lockfile --ignore-scripts

CMD ["bun", "run", "migrate"]
