# syntax=docker/dockerfile:1.7

ARG BUN_IMAGE=oven/bun:1.3.14-slim
FROM ${BUN_IMAGE}

WORKDIR /app

COPY package.json bun.lock bunfig.toml ./
COPY apps/app/package.json ./apps/app/package.json
COPY apps/web/package.json ./apps/web/package.json
COPY apps/workers/package.json ./apps/workers/package.json
COPY packages/ai/package.json ./packages/ai/package.json
COPY packages/contracts/package.json ./packages/contracts/package.json
COPY packages/spice-db ./packages/spice-db
COPY packages/core ./packages/core
COPY packages/db/package.json ./packages/db/package.json
COPY packages/notifications/package.json ./packages/notifications/package.json
COPY packages/observability/package.json ./packages/observability/package.json
COPY packages/pg-boss/package.json ./packages/pg-boss/package.json
COPY packages/process/package.json ./packages/process/package.json
COPY packages/qdrant/package.json ./packages/qdrant/package.json
COPY packages/quota/package.json ./packages/quota/package.json
COPY packages/s3/package.json ./packages/s3/package.json
COPY packages/schema/package.json ./packages/schema/package.json
COPY packages/valkey/package.json ./packages/valkey/package.json

WORKDIR /app/packages/spice-db

RUN bun install --frozen-lockfile --ignore-scripts

USER bun

CMD ["bun", "run", "up"]
