# syntax=docker/dockerfile:1.7

ARG BUN_IMAGE=oven/bun:1.3.11
FROM ${BUN_IMAGE}

WORKDIR /app

COPY package.json ./

# Install only what is needed to run SpiceDB migrations.
RUN export AUTHZED_NODE_VERSION=$(node -pe "require('./package.json').dependencies['@authzed/authzed-node']") && \
  rm package.json && \
  bun install @authzed/authzed-node@$AUTHZED_NODE_VERSION --force

COPY scripts/migrate-spicedb-schema.ts ./scripts/migrate-spicedb-schema.ts
COPY scripts/spice-converge ./scripts/spice-converge
COPY src/lib/spice-db/schema.zed ./src/lib/spice-db/schema.zed

USER bun

CMD ["bun", "run", "scripts/migrate-spicedb-schema.ts", "up"]
