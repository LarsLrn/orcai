{
	"name": "orcai-workspace",
	"private": true,
	"workspaces": {
		"packages": [
			"apps/*",
			"packages/*"
		],
		"catalog": {
			"@authzed/authzed-node": "1.6.1",
			"@effect/opentelemetry": "4.0.0-beta.66",
			"@effect/sql-pg": "4.0.0-beta.66",
			"@qdrant/qdrant-js": "1.18.0",
			"@types/node": "25.8.0",
			"@types/pg": "8.20.0",
			"ai": "6.0.177",
			"drizzle-kit": "1.0.0-rc.2",
			"drizzle-orm": "1.0.0-rc.2",
			"effect": "4.0.0-beta.66",
			"@orpc/contract": "1.14.3",
			"pg": "8.20.0",
			"uuid": "14.0.0",
			"zod": "4.4.3"
		}
	},
	"scripts": {
		"biome:check:unsafe": "biome check . --write --unsafe",
		"build": "bun run --filter @orcai/app build",
		"clean": "rm -rf node_modules apps/*/node_modules packages/*/node_modules dist apps/*/dist packages/*/dist .tanstack apps/*/.tanstack .devtools apps/*/.devtools **/tsconfig.tsbuildinfo",
		"dev": "bun run --filter @orcai/app dev",
		"knip": "knip",
		"lint": "biome check . && tsgo --build --noEmit tsconfig.json",
		"lint-full": "biome check . && tsgo --build --noEmit tsconfig.json && bun run eslint .",
		"machine-translate": "bun run --filter @orcai/app machine-translate",
		"precommit": "lint-staged",
		"prepare": "husky",
		"prepush": "bun run lint-full",
		"start": "bun run --filter @orcai/app start",
		"workers:dev": "bun run --filter @orcai/workers dev",
		"workers:start": "bun run --filter @orcai/workers start"
	},
	"lint-staged": {
		"*.{ts,tsx,js,jsx,cjs,mjs,json,css,md}": [
			"biome format --write"
		]
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.15",
		"@commitlint/cli": "21.0.1",
		"@commitlint/config-conventional": "21.0.1",
		"@effect/language-service": "0.86.1",
		"@tanstack/eslint-plugin-query": "5.100.10",
		"@tanstack/eslint-plugin-router": "1.161.6",
		"@types/bun": "1.3.14",
		"@typescript/native-preview": "7.0.0-dev.20260515.1",
		"eslint": "10.4.0",
		"eslint-plugin-drizzle": "1.0.0-rc.2",
		"husky": "9.1.7",
		"knip": "6.12.2",
		"lint-staged": "17.0.4",
		"typescript": "6.0.3",
		"typescript-eslint": "8.59.3"
	},
	"packageManager": "bun@1.3.14",
	"engines": {
		"bun": ">=1.3.10"
	},
	"trustedDependencies": []
}
