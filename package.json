{
	"name": "orcai-workspace",
	"private": true,
	"license": "AGPL-3.0-only",
	"workspaces": {
		"packages": [
			"apps/*",
			"packages/*"
		],
		"catalog": {
			"@authzed/authzed-node": "1.6.1",
			"@effect/opentelemetry": "4.0.0-beta.90",
			"@effect/sql-pg": "4.0.0-beta.90",
			"@orpc/contract": "2.0.0-beta.15",
			"@orpc/openapi": "2.0.0-beta.15",
			"@qdrant/qdrant-js": "1.18.0",
			"@tailwindcss/vite": "4.3.2",
			"@tanstack/react-router": "1.170.17",
			"@tanstack/react-router-devtools": "1.167.0",
			"@tanstack/react-start": "1.168.27",
			"@types/bun": "1.3.14",
			"@types/node": "26.1.0",
			"@types/pg": "8.20.0",
			"@types/react": "^19.2.17",
			"@types/react-dom": "^19.2.3",
			"@vitejs/plugin-react": "6.0.3",
			"ai": "7.0.15",
			"drizzle-kit": "1.0.0-rc.4",
			"drizzle-orm": "1.0.0-rc.4",
			"effect": "4.0.0-beta.90",
			"lucide-react": "1.23.0",
			"pg": "8.22.0",
			"react": "19.2.7",
			"react-dom": "19.2.7",
			"tailwind-merge": "3.6.0",
			"tailwindcss": "4.3.2",
			"uuid": "14.0.1",
			"vite": "8.1.3",
			"zod": "4.4.3"
		}
	},
	"scripts": {
		"biome:check:unsafe": "biome check . --write --unsafe",
		"build": "bun run build:app && bun run build:web",
		"build:app": "bun run --filter @orcai/app build",
		"build:web": "bun run --filter @orcai/web build",
		"ci": "bun run lint-full && bun run test && bun run --filter @orcai/web types:check && bun run build",
		"clean": "rm -rf node_modules apps/*/node_modules packages/*/node_modules dist apps/*/dist packages/*/dist .tanstack apps/*/.tanstack .devtools apps/*/.devtools **/tsconfig.tsbuildinfo",
		"dev": "bun run --filter @orcai/app dev",
		"knip": "knip",
		"lint": "biome check . && tsgo --build --noEmit tsconfig.json",
		"lint-full": "biome check . && tsgo --build --noEmit tsconfig.json && bun run eslint .",
		"machine-translate": "bun run --filter @orcai/app machine-translate",
		"precommit": "lint-staged",
		"prepare": "husky",
		"prepush": "bun run lint-full",
		"start": "bun run --filter @orcai/app start",
		"test": "bun test --recursive packages/**/test/*.test.ts packages/**/test/**/*.test.ts",
		"workers:dev": "bun run --filter @orcai/workers dev",
		"workers:start": "bun run --filter @orcai/workers start"
	},
	"lint-staged": {
		"*.{ts,tsx,js,jsx,cjs,mjs,json,css,md}": [
			"biome format --write"
		]
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.2",
		"@commitlint/cli": "21.2.0",
		"@commitlint/config-conventional": "21.2.0",
		"@effect/language-service": "0.86.4",
		"@tanstack/eslint-plugin-query": "5.101.2",
		"@tanstack/eslint-plugin-router": "1.162.0",
		"@types/bun": "catalog:",
		"@typescript/native-preview": "7.0.0-dev.20260704.1",
		"eslint": "10.6.0",
		"eslint-plugin-drizzle": "1.0.0-rc.4",
		"husky": "9.1.7",
		"knip": "6.24.0",
		"lint-staged": "17.0.8",
		"typescript": "6.0.3",
		"typescript-eslint": "8.62.1"
	},
	"packageManager": "bun@1.3.14",
	"engines": {
		"bun": ">=1.3.10"
	},
	"trustedDependencies": []
}
