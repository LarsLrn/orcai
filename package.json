	"name": "sokratest",
	"version": "0.2.0",
	"description": "AI tutoring platform for higher education",
	"author": "Lars Lorenz",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"biome:check:unsafe": "biome check . --write --unsafe",
		"format": "biome format --write",
		"knip": "knip",
		"ai:devtools": "bunx @ai-sdk/devtools",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"db:push": "drizzle-kit push",
		"db:pull": "drizzle-kit pull",
		"db:check": "drizzle-kit check",
		"db:up": "drizzle-kit up",
		"db:seed": "tsx scripts/seed.ts",
		"spice:deploy-schema": "tsx scripts/deploy-spicedb-schema.ts",
		"trigger:dev": "dotenv -- sh -c 'bunx trigger.dev@latest dev -a ${TRIGGER_API_URL}'",
		"trigger:deploy": "dotenv -- sh -c 'bunx trigger.dev deploy -p ${TRIGGER_PROJECT:?TRIGGER_PROJECT not set} --self-hosted --push --registry ghcr.io --namespace sokratest'",
		"machine-translate": "inlang machine translate --project project.inlang",
		"precommit": "lint-staged"
	},
	"lint-staged": {
		"*.{ts,tsx,js,jsx,cjs,mjs,json,css,md}": [
			"biome format --write"
		]
	},
