{
	"name": "sokratest",
	"version": "0.2.0",
	"description": "AI tutoring platform for higher education",
	"author": "Lars Lorenz",
	"private": true,
	"type": "module",
	"packageManager": "bun@1.3.10",
	"engines": {
		"bun": ">=1.3.10"
	},
	"scripts": {
		"dev": "vite dev --host 127.0.0.1",
		"build": "vite build",
		"start": "bun run start-server.ts",
		"biome:check:unsafe": "biome check . --write --unsafe",
		"lint": "biome check . && tsc --noEmit",
		"knip": "knip",
		"ai:devtools": "bunx @ai-sdk/devtools",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"db:push": "drizzle-kit push",
		"db:pull": "drizzle-kit pull",
		"db:check": "drizzle-kit check",
		"db:up": "drizzle-kit up",
		"db:seed": "tsx scripts/seed.ts",
		"spice:deploy-schema": "bun run scripts/deploy-spicedb-schema.ts",
		"machine-translate": "inlang machine translate --project project.inlang",
		"precommit": "lint-staged",
		"prepush": "bun run lint",
		"prepare": "husky"
	},
	"lint-staged": {
		"*.{ts,tsx,js,jsx,cjs,mjs,json,css,md}": [
			"biome format --write"
		]
	},
